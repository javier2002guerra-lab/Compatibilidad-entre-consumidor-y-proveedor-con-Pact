{
  "name": "pact-product-catalog",
  "version": "1.0.0",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "clean:pacts": "node -e \"require('fs').rmSync('pacts',{recursive:true,force:true})\"",
    "pretest:consumer": "npm run clean:pacts",
    "test:consumer": "jest test/consumer",
    "test:provider": "jest test/provider",
    "test:contract": "npm run test:consumer && npm run test:provider",
    "start:provider": "tsx src/provider/server.ts",
    "breaking:apply": "git apply breaking-change/price-as-string.patch",
    "breaking:revert": "git apply -R breaking-change/price-as-string.patch",
    "demo:breaking": "node scripts/demo-breaking-change.js"
  },
  "author": "",
  "license": "MIT",
  "description": "Pruebas de contrato dirigidas por el consumidor con Pact (TypeScript)",
  "devDependencies": {
    "@pact-foundation/pact": "^13.2.0",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "express": "^4.22.3"
  },
  "engines": {
    "node": ">=18"
  }
}
